root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,ts,tsx,mjs,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Evidence and frozen fixtures are compared byte for byte.
[{examples/citalab_r02/data/**,tests/fixtures/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
